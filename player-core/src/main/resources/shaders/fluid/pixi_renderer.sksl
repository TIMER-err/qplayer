uniform float2 resolution;
uniform float time;
uniform float bend;
uniform float beat;
uniform shader cover;
uniform float4 angles;

const float TEX_SIZE = 32.0;

float2 bulge(float2 coord, float2 center, float radius) {
    float2 delta = coord - center;
    float dist = length(delta);
    if (dist > 0.0001 && dist < radius) {
        float percent = dist / radius;
        float warped = smoothstep(0.0, 1.0 / percent, percent);
        delta *= mix(1.0, warped, 0.75);
    }
    return center + delta;
}

float2 sCurve(float2 coord) {
    float radius = (max(resolution.x, resolution.y) + min(resolution.x, resolution.y)) * 0.5;
    float left = bend > 0.0 ? 0.25 : 0.75;
    float right = 1.0 - left;
    coord = bulge(coord, float2(right * resolution.x, 0.0), radius);
    return bulge(coord, float2(left * resolution.x, resolution.y), radius);
}

float3 spriteMap(float2 coord, float2 position, float size, float angle, float featherPx) {
    float2 p = coord - position;
    float cs = cos(angle);
    float sn = sin(angle);
    float2 local = float2(p.x * cs + p.y * sn, -p.x * sn + p.y * cs) / size + 0.5;
    float inside = 0.5 - max(abs(local.x - 0.5), abs(local.y - 0.5));
    float mask = smoothstep(-featherPx / size, featherPx / size, inside);
    return float3(local, mask);
}

float3 pixiColor(float3 rgb) {
    rgb = float3(1.8 * rgb.r - 0.4 * rgb.g - 0.4 * rgb.b,
                 -0.4 * rgb.r + 1.8 * rgb.g - 0.4 * rgb.b,
                 -0.4 * rgb.r - 0.4 * rgb.g + 1.8 * rgb.b);
    rgb = clamp(rgb, 0.0, 1.0);
    rgb = clamp(rgb * 0.6, 0.0, 1.0);
    return clamp(rgb * 1.3 - 0.15, 0.0, 1.0);
}

float3 sampleCurrent(float2 coord) {
    float maxSize = max(resolution.x, resolution.y);
    float feather = min(resolution.x, resolution.y) * 0.115;
    float3 m1 = spriteMap(coord, resolution * 0.5, maxSize * 1.41421356,
                          angles.x + time * 0.06, feather);
    float3 rgb = float3(cover.eval(m1.xy * TEX_SIZE).rgb);
    float3 m2 = spriteMap(coord, resolution / 2.5, maxSize * 0.8,
                          angles.y - time * 0.12, feather);
    rgb = mix(rgb, float3(cover.eval(m2.xy * TEX_SIZE).rgb), m2.z);
    float travel = cos(time * 0.045) * resolution.x * 0.25;
    float3 m3 = spriteMap(coord, resolution * 0.5 + float2(travel),
                          maxSize * 0.5, angles.z + time * 0.06, feather);
    rgb = mix(rgb, float3(cover.eval(m3.xy * TEX_SIZE).rgb), m3.z);
    float drift = resolution.x * 0.025 + cos(time * 0.27);
    float3 m4 = spriteMap(coord, resolution * 0.5 + float2(drift),
                          maxSize * 0.25, angles.w - time * 0.08, feather);
    rgb = mix(rgb, float3(cover.eval(m4.xy * TEX_SIZE).rgb), m4.z);
    return pixiColor(rgb);
}

half4 main(float2 fragCoord) {
    float zoom = 1.0 - 0.09 * beat;
    float2 uv = (sCurve(fragCoord) - 0.5) * zoom + 0.5;
    return half4(sampleCurrent(uv), 1.0);
}

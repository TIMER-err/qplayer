// QPlayer 歌词动态背景「动态背景（网格形变）」的片元着色器。
//
// 逐行移植自 Documents/ui/ui/dynamic_background.js 里的 FRAGMENT_SOURCE ——
// 那份是网易云动态背景（资源 0x7A9CBB58）的 WebGL 翻译，常数取自同一份原型的
// source_algorithms.js（backgroundSaturation / ...BlackScrimAlpha / ...WhiteScrimAlpha /
// ...DarkAlpha / 三个 TIME_SCALE 等）。
//
// 与原型的三处结构性差异（都不是行为改动，是宿主不同）：
//
//   1. 原型的网格形变在**顶点着色器**里（画面被网格推着走、纹理坐标保持规则），
//      这里由 Skia 的 drawVertices 承担同一件事（positions 走形变、texCoords 走规则 uv），
//      所以本着色器拿到的 localCoord 就是那块**规则 uv**（原型的 vCoordinate / aRegular）。
//   2. 原型用 uTexture0/uTexture1 + uLerp1 在两张纹理之间过渡（视频场景）；换曲的交叉淡入
//      由 QPlayer 用两次 draw + alpha 完成，所以这里没有第二个 cover 与 lerp。
//   3. 未加音乐频谱时 low/mid/high 全为 0，此时 spectrumScale/Contrast/Saturation
//      退化成原型里"没在放歌"的那一档（不是另一套公式）。

uniform float2 resolution;   // 渲染分辨率（原型的 uResolution）
uniform float time;          // 原型的 uTime（= phase / 60）
uniform float low;           // 低频电平 0..1（原型的 uLowFreq）
uniform float mid;           // 中频电平 0..1（原型的 uMidFreq）
uniform float high;          // 高频电平 0..1（原型的 uHighFreq）
uniform float hasLyric;      // 有没有歌词在屏幕上（原型的 uHasLyric，0/1）
uniform float alpha;         // 整体不透明度：换曲交叉淡入时用（1.0 = 原型的画面）
uniform shader cover;        // 192×192 的封面（MIRROR 取样）

// 封面纹理边长（MeshWarp.ART）。纹理坐标按 1 单位 = 1 纹素映射。
const float ART = 192.0;

// ---- 原型 source_algorithms.js 里的常数，一个都没改 ----
const float SPEC_MIX_FACTOR = 0.1;
const float SPEC_SCALE_COEFF = 0.33;
const float SPEC_CONTRAST_COEFF = 0.076;
const float SPEC_SAT_COEFF = 0.166;
const float INSTANCE_SCRIM_STEP = 0.0076;
const float LUM_R = 0.2126;
const float LUM_G = 0.7152;
const float LUM_B = 0.0722;
const float PINCH_ZOOM_MIN = 1.0;
const float TIME_SCALE_0 = 120.0;
const float TIME_SCALE_1 = 70.0;
const float TIME_SCALE_2 = 90.0;
const float PLAIN_SATURATION = 1.0;        // backgroundSaturation
const float BLACK_SCRIM_ALPHA = 0.35;      // backgroundBlackScrimAlpha
const float WHITE_SCRIM_ALPHA = 0.095;     // backgroundWhiteScrimAlpha
const float DARK_OVERLAY_ALPHA = 100.0 / 255.0;  // backgroundDarkAlpha

float3 applySaturationMatrix(float3 color, float saturation) {
    float inverseSaturation = 1.0 - saturation;
    float rLuma = inverseSaturation * LUM_R;
    float gLuma = inverseSaturation * LUM_G;
    float bLuma = inverseSaturation * LUM_B;
    return float3(
        (rLuma + saturation) * color.r + gLuma * color.g + bLuma * color.b,
        rLuma * color.r + (gLuma + saturation) * color.g + bLuma * color.b,
        rLuma * color.r + gLuma * color.g + (bLuma + saturation) * color.b
    );
}

float3 sampleArtwork(float2 coordinate) {
    // 原型是 MIRRORED_REPEAT 取样全分辨率封面；这里 cover 子着色器同样按 MIRROR 建，
    // 所以落在 [0,1] 外的坐标会镜像回去（三层方块各自露出封面的一部分，正是那个拼贴感）
    return float3(cover.eval(coordinate * ART).rgb);
}

// 一个旋转方块层的颜色与覆盖掩码。原型的 calculateLayer 返回 vec4(color, 1) / vec4(0)，
// 这里拆成 (color, mask) 两个返回值，避免在 SkSL 里用分支丢像素。
float3 calculateLayer(float2 uv, float2 center, float size, float rotation, float scrim,
                      float saturation, float spectrumContrast, out float mask) {
    float2 position = uv - center;
    float cosine = cos(rotation);
    float sine = sin(rotation);
    float2 rotated = float2(
        position.x * cosine - position.y * sine,
        position.x * sine + position.y * cosine
    );
    float halfSize = size * 0.5;
    if (abs(rotated.x) > halfSize || abs(rotated.y) > halfSize) {
        mask = 0.0;
        return float3(0.0);
    }
    mask = 1.0;
    float3 color = sampleArtwork(rotated / size - 0.5);
    color = mix(color, float3(0.0), scrim);
    color = (color - 0.5) * spectrumContrast + 0.5;
    return applySaturationMatrix(color, saturation);
}

half4 main(float2 localCoord) {
    float2 textureCoordinate = localCoord;
    float pinchMix = hasLyric;
    float zoomScale = (1.0 - pinchMix) * 0.25 + PINCH_ZOOM_MIN;
    float ydx = resolution.y / resolution.x;
    float xdy = resolution.x / resolution.y;

    float spectrumMix = mix(low, mid, SPEC_MIX_FACTOR);
    float spectrumScale = spectrumMix * spectrumMix * SPEC_SCALE_COEFF + 1.0;
    float spectrumContrast = low * SPEC_CONTRAST_COEFF + 1.0;
    float saturation = PLAIN_SATURATION + high * SPEC_SAT_COEFF
        + (1.0 - pinchMix) * 0.5;

    const float TWO_PI = 6.2831853;
    float angle0 = time * TWO_PI / TIME_SCALE_0;
    float angle1 = time * TWO_PI / TIME_SCALE_1;
    float angle2 = time * TWO_PI / TIME_SCALE_2 + 3.1415926;

    float2 centered = textureCoordinate - 0.5;
    centered /= spectrumScale * zoomScale;
    float2 uv = centered * 2.0;
    if (resolution.x >= resolution.y) {
        uv.y *= ydx;
    } else {
        uv.x *= xdy;
    }

    float2 center0 = float2(0.0);
    float2 center1 = float2(0.1 + cos(-angle1 * 0.5), sin(-angle1 * 0.5));
    float2 center2 = float2(-0.25, 0.15);

    float mask0;
    float mask1;
    float mask2;
    float3 layer0 = calculateLayer(uv, center0, 2.8, angle0, 0.0,
            saturation, spectrumContrast, mask0);
    float3 layer1 = calculateLayer(uv, center1, 1.4, angle1, INSTANCE_SCRIM_STEP,
            saturation, spectrumContrast, mask1);
    float3 layer2 = calculateLayer(uv, center2, 1.4, angle2, INSTANCE_SCRIM_STEP * 2.0,
            saturation, spectrumContrast, mask2);

    // 叠加顺序与原型一致：0 在最下面（它铺满整屏），然后 2，最后 1
    float3 result = float3(0.0);
    result = mix(result, layer0, mask0);
    result = mix(result, layer2, mask2);
    result = mix(result, layer1, mask1);
    result = mix(result, float3(1.0), WHITE_SCRIM_ALPHA);
    result = result * (1.0 - DARK_OVERLAY_ALPHA);

    // 预乘输出：alpha=1 时与原型的 vec4(rgb, 1) 完全等价；交叉淡入时按 fade 叠在上一次画面之上
    return half4(half3(result * alpha), half(alpha));
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.t1m3.qplayer</groupId>
        <artifactId>musicplayer-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>player-core</artifactId>
    <name>Player Core</name>
    <description>Platform-neutral player logic and packaged-QML scene runtime. Must stay Android-dexable: bundled UI classes are produced by qml-aot-tool before either host compiles/packages, never ASM/D8-compiled at runtime. Native Skija libraries are supplied by each shell.</description>

    <properties>
        <!-- Skija native used only by this module's own tests. Defaults to Linux x64;
             the os-activated profiles below select the build host's platform. -->
        <qplayer.skija.platform>linux-x64</qplayer.skija.platform>
    </properties>

    <dependencies>
        <!-- QML engine: the reactive Property bridge to QML + Renderer/QmlView used
             by the host-drawn lyric compositor. -->
        <dependency>
            <groupId>io.github.timer-err</groupId>
            <artifactId>qml4j-core</artifactId>
        </dependency>

        <!-- Declared explicitly because the source-plugin runtime is a public
             player-core subsystem rather than an incidental qml4j transitive. -->
        <dependency>
            <groupId>org.mozilla</groupId>
            <artifactId>rhino</artifactId>
            <version>1.9.1</version>
        </dependency>

        <!-- JVM artifact is required for Maven; Android selects the platform
             variant from okhttp's Gradle module metadata instead. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- Skija (platform-neutral classes) for the fluid lyric backdrop + the
             per-syllable renderer. The native lib is provided by each shell
             (skija-android-arm64 / skija-linux-x64 / …). -->
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-shared</artifactId>
            <version>${skija.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- Large bundled fonts are stored as .xz assets. XZ for Java is pure
             Java and Android-compatible; loading remains transparent to hosts. -->
        <dependency>
            <groupId>org.tukaani</groupId>
            <artifactId>xz</artifactId>
        </dependency>

        <!-- Pure-Java QR encoding for the netease login dialog. core only —
             no javase/ImageIO module, so it stays Android-dexable. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Image decoding, fonts and other Skija paths need the native library.
             Without it, tests exercising them only saw a linkage error in a
             background thread and passed without testing anything. Test scope:
             each shell still supplies its own native at runtime. -->
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-${qplayer.skija.platform}</artifactId>
            <version>${skija.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><qplayer.skija.platform>windows-x64</qplayer.skija.platform></properties>
        </profile>
        <profile>
            <id>os-macos-x64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties><qplayer.skija.platform>macos-x64</qplayer.skija.platform></properties>
        </profile>
        <profile>
            <id>os-macos-arm64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><qplayer.skija.platform>macos-arm64</qplayer.skija.platform></properties>
        </profile>
    </profiles>
</project>

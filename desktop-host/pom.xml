<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.t1m3.qplayer</groupId>
        <artifactId>musicplayer-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>desktop-host</artifactId>
    <name>Desktop Host</name>
    <description>LWJGL/Skija desktop host with build-time QML and GraalVM Native Image distribution.</description>

    <properties>
        <!-- Java 17 source; JVM development uses JDK 21+, Native Image uses GraalVM 25.
             Keep the Android-shared player-core on Java 8. -->
        <maven.compiler.release>17</maven.compiler.release>
        <lwjgl.version>3.3.3</lwjgl.version>
        <!-- The native classifiers for THIS build host. Defaults target Linux x64;
             the os-activated profiles below flip them for Windows / macOS (intel &
             apple-silicon). Native Image cannot cross-build, so each platform's
             release is produced on its own runner with the matching natives. -->
        <lwjgl.natives>natives-linux</lwjgl.natives>
        <qplayer.skija.platform>linux-x64</qplayer.skija.platform>
        <log4j.version>2.25.5</log4j.version>
        <jna.version>5.14.0</jna.version>
        <native.buildtools.version>1.1.17</native.buildtools.version>
        <!-- App version baked into version.properties (read by Main → the update
             check). Local dev default; the release workflow overrides it with the
             git tag (-Dqplayer.app.version=…) so release binaries match the tag
             without a committed bump, like the macOS/Windows packagers. -->
        <qplayer.app.version>1.9.4-rc.4</qplayer.app.version>
        <!-- exec:exec run knobs. Empty gfx means use the persisted in-app setting;
             pass -Dgfx=gl|vulkan only when an explicit development override is
             wanted. -->
        <gfx></gfx>
        <win.w>1100</win.w>
        <win.h>720</win.h>
        <!-- Optional isolated profile root, useful for parallel/demo instances. -->
        <data.dir></data.dir>
        <frame.trace></frame.trace>
        <frame.readback>false</frame.readback>
        <gl.context>auto</gl.context>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${native.buildtools.version}</version>
                    <configuration>
                        <imageName>qplayer</imageName>
                        <mainClass>dev.t1m3.qplayer.desktop.app.Main</mainClass>
                        <metadataRepository>
                            <enabled>true</enabled>
                            <version>1.0.20</version>
                        </metadataRepository>
                        <buildArgs>
                            <buildArg>-march=compatibility</buildArg>
                            <buildArg>--enable-url-protocols=http,https</buildArg>
                            <buildArg>--exact-reachability-metadata</buildArg>
                            <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                            <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                            <buildArg>-R:MissingRegistrationReportingMode=Exit</buildArg>
                            <buildArg>-H:+AddAllCharsets</buildArg>
                            <buildArg>-H:+IncludeAllLocales</buildArg>
                            <buildArg>-R:MaxHeapSize=768m</buildArg>
                            <buildArg>--initialize-at-run-time=org.lwjgl,io.github.humbleui.skija,com.sun.jna,org.mozilla.javascript,io.github.timer_err.qml4j,dev.t1m3.qplayer</buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <resources>
            <!-- Keep the default resource dir (log4j2.xml) — declaring <resources>
                 at all otherwise replaces it. -->
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!-- Maven-filtered: substitutes ${qplayer.app.version} into
                 version.properties. Kept in its own dir so filtering never touches
                 the QML / fonts below. -->
            <resource>
                <directory>${project.basedir}/src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Mount the shared QML tree (Main.qml + app pages + miuix/Core + fonts)
                 onto the classpath so ClasspathResourceLoader serves it exactly like
                 the Android shell's merged assets. -->
            <resource>
                <directory>${project.basedir}/../shared-qml</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/qml-aot/classes</directory>
            </resource>
        </resources>

        <plugins>
            <!-- Run the desktop app in a fresh JVM (real main thread, which GLFW needs)
                 with the full runtime classpath incl. Skija + LWJGL natives:
                   mvn -pl desktop-host -am install        # build once
                   mvn -pl desktop-host exec:exec          # run (OpenGL, default)
                   mvn -pl desktop-host exec:exec -Dgfx=vulkan
                 -Dgfx / -Dwin.w / -Dwin.h forward to the app. On macOS add
                 -XstartOnFirstThread to <argument>s. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>dev.t1m3.qplayer</groupId>
                        <artifactId>qml-aot-tool</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-Dqplayer.gfx=${gfx}</argument>
                        <argument>-Dqplayer.width=${win.w}</argument>
                        <argument>-Dqplayer.height=${win.h}</argument>
                        <argument>-Dqplayer.data.dir=${data.dir}</argument>
                        <argument>-Dqplayer.frameTrace=${frame.trace}</argument>
                        <argument>-Dqplayer.frameReadback=${frame.readback}</argument>
                        <argument>-Dqplayer.glContext=${gl.context}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>dev.t1m3.qplayer.desktop.app.Main</argument>
                    </arguments>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-bundled-qml</id>
                        <phase>generate-resources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>dev.t1m3.qplayer.aot.build.QmlBundleCompiler</mainClass>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments combine.self="override">
                                <argument>--input</argument><argument>${project.basedir}/../shared-qml</argument>
                                <argument>--output</argument><argument>${project.build.directory}/qml-aot</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>configure-native-webview</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <environmentVariables><JAVA_HOME>${java.home}</JAVA_HOME></environmentVariables>
                            <arguments combine.self="override">
                                <argument>-S</argument><argument>${project.basedir}/native/webview</argument>
                                <argument>-B</argument><argument>${project.build.directory}/webview-native</argument>
                                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                <argument>-DCMAKE_INSTALL_PREFIX=${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-native-webview</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <arguments combine.self="override">
                                <argument>--build</argument><argument>${project.build.directory}/webview-native</argument>
                                <argument>--config</argument><argument>Release</argument>
                                <argument>--parallel</argument><argument>2</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-native-webview</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>cmake</executable>
                            <arguments combine.self="override">
                                <argument>--install</argument><argument>${project.build.directory}/webview-native</argument>
                                <argument>--config</argument><argument>Release</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>native-host-metadata</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>dev.t1m3.qplayer.aot.build.DesktopNativeMetadata</mainClass>
                            <includeProjectDependencies>true</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <classpathScope>runtime</classpathScope>
                            <arguments combine.self="override">
                                <argument>--output</argument><argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>smoke-packaged-qml</id>
                        <phase>integration-test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <!-- JNI and process-wide font workers belong to the app JVM,
                                 not Maven's temporary exec:java classloader. -->
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>runtime</classpathScope>
                            <arguments combine.self="override">
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-classpath</argument><classpath/>
                                <argument>dev.t1m3.qplayer.desktop.app.Main</argument>
                                <argument>--build-smoke</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.lwjgl</groupId>
                <artifactId>lwjgl-bom</artifactId>
                <version>${lwjgl.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Player core: local library + plugin host + audio abstraction + QML bridge + the host-drawn
             lyric page (fluid backdrop + per-syllable renderer + compositor). -->
        <dependency>
            <groupId>dev.t1m3.qplayer</groupId>
            <artifactId>player-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- QML engine + desktop-native Skija (provided by engine as `provided`) -->
        <dependency>
            <groupId>io.github.timer-err</groupId>
            <artifactId>qml4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-${qplayer.skija.platform}</artifactId>
            <version>${skija.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- LWJGL3: GLFW window/input + OpenGL + Vulkan loaders. The switchable
             graphics backend uses GL by default and Vulkan behind -Dqplayer.gfx=vulkan. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-vulkan</artifactId>
        </dependency>
        <!-- Audio: OpenAL Soft drives the output device (replaces javax.sound, which
             has no Mixer in the native image on macOS); stb_vorbis decodes ogg with
             real sample-accurate seek. Both load through the same LWJGL native path
             the graphics modules already use, so the image needs no extra config. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
        </dependency>
        <!-- LWJGL native libraries for this host. lwjgl-vulkan ships no natives jar
             (it binds the system Vulkan loader / MoltenVK). -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- @NotNull annotations on Main/DesktopAudioBackend. Used to come in
             transitively via dorkbox SystemTray; pin it directly now. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Logging backend for the desktop host: the shared player-core Logger
             routes through a log4j2 Sink installed in Main. Kept out of player-core
             so Android keeps its java.util.logging → logcat path. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Native system integration: Win32/COM, Cocoa and GLib/D-Bus.
             No AWT or Swing runtime is required. -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- Desktop audio decoders. We drive these libraries directly (no
             javax.sound SPI / AudioSystem) so each can seek for real instead of
             decode-and-discard from zero: jlayer (mp3) frame-walks headers,
             jflac (flac) uses FLACDecoder.seek, ogg goes through stb_vorbis above.
             jaudiotagger stays for reading tags. -->
        <dependency>
            <groupId>net.jthink</groupId>
            <artifactId>jaudiotagger</artifactId>
            <version>${jaudiotagger.version}</version>
        </dependency>
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>jlayer</artifactId>
            <version>1.0.1.4</version>
        </dependency>
        <dependency>
            <groupId>org.jflac</groupId>
            <artifactId>jflac-codec</artifactId>
            <version>1.5.2</version>
        </dependency>
        <!-- Pure-Java AAC decoder. MP4 sample extraction is handled by the host
             so both ordinary files and fragmented DASH audio can stream. -->
        <dependency>
            <groupId>com.tianscar.javasound</groupId>
            <artifactId>jaad</artifactId>
            <version>0.9.4</version>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Per-OS native classifiers (auto-activated by the build host). -->
        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <qplayer.skija.platform>windows-x64</qplayer.skija.platform>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.graalvm.buildtools</groupId>
                            <artifactId>native-maven-plugin</artifactId>
                            <configuration>
                                <buildArgs combine.children="append">
                                    <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:WINDOWS</buildArg>
                                    <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                                    <buildArg>-H:NativeLinkerOption=${project.build.directory}/qplayer-version.res</buildArg>
                                </buildArgs>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>windows-executable-resources</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments combine.self="override">
                                        <argument>-NoProfile</argument><argument>-ExecutionPolicy</argument><argument>Bypass</argument>
                                        <argument>-File</argument><argument>${project.basedir}/dist/native-windows-resources.ps1</argument>
                                        <argument>-AppVersion</argument><argument>${qplayer.app.version}</argument>
                                        <argument>-OutputDirectory</argument><argument>${project.build.directory}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>os-macos-x64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <qplayer.skija.platform>macos-x64</qplayer.skija.platform>
            </properties>
        </profile>
        <profile>
            <id>os-macos-arm64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <qplayer.skija.platform>macos-arm64</qplayer.skija.platform>
            </properties>
        </profile>

        <!-- Explicit SDK search path for nonstandard toolchains (e.g. Nix zlib).
             Values are comma-separated linker directories, never machine paths in the pom. -->
        <profile>
            <id>native-library-path</id>
            <activation><property><name>qplayer.native.library.path</name></property></activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.graalvm.buildtools</groupId>
                            <artifactId>native-maven-plugin</artifactId>
                            <configuration>
                                <buildArgs combine.children="append">
                                    <buildArg>-H:CLibraryPath=${qplayer.native.library.path}</buildArg>
                                </buildArgs>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>

        <!-- The distribution contains a real native executable, not a JVM launcher. -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>stage-native-dependency-licenses</id>
                                <phase>prepare-package</phase>
                                <goals><goal>unpack-dependencies</goal></goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <includes>META-INF/LICENSE*,META-INF/NOTICE*,META-INF/licenses/**,LICENSE*,NOTICE*,license/**,licenses/**</includes>
                                    <outputDirectory>${project.build.directory}/native-legal/dependencies</outputDirectory>
                                    <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-native-runtime-licenses</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <copy todir="${project.build.directory}/native-legal/graalvm">
                                            <fileset dir="${java.home}/legal"/>
                                        </copy>
                                        <copy file="${project.basedir}/../LICENSE.md" todir="${project.build.directory}/native-legal/qplayer"/>
                                        <copy file="${project.basedir}/../shared-qml/miuix/LICENSE.md" todir="${project.build.directory}/native-legal/miuix"/>
                                        <copy todir="${project.build.directory}/native-legal/qplayer/META-INF">
                                            <fileset dir="${project.build.outputDirectory}/META-INF">
                                                <include name="LICENSE*"/><include name="NOTICE*"/><include name="licenses/**"/>
                                            </fileset>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-native-executable</id>
                                <phase>package</phase>
                                <goals><goal>compile-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
